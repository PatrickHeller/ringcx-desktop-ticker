{
  "name": "ringcx-desktop-ticker",
  "version": "1.0.2",
  "description": "Live-Ticker-Desktop-App für RingCX Queue- und Agenten-Echtzeitdaten",
  "main": "src/main.js",
  "author": {
    "name": "Patrick Heller",
    "email": "helllerpat@gmail.com"
  },
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "de.p-h-c.ringcx-desktop-ticker",
    "productName": "RingCX Ticker",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.business"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
